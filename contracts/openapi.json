            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "refresh-cookie": []
          }
        ],
        "summary": "Revoca la sesión asociada a la cookie de refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
