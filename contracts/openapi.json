          },
          "401": {
            "description": "Sesión revocada, expirada o inválida."
          },
          "403": {
            "description": "Falta la intención explícita o el origen no está permitido."
          }
        },
        "security": [
          {
            "refresh-cookie": []
          }
        ],
        "summary": "Rota el refresh token y emite un nuevo access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
