      }
    },
    "/projects/{projectId}/documents/{documentId}": {
      "get": {
        "operationId": "DocumentsController_get",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Documento inexistente o perteneciente a otro proyecto."
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Consulta el modelo canónico dentro del proyecto autorizado",
        "tags": [
          "uml-documents"
        ]
      },
      "put": {
        "operationId": "DocumentsController_update",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDocumentDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "DTO o canonicalModel inválidos."
          },
          "404": {
            "description": "Documento inexistente o perteneciente a otro proyecto."
          },
          "409": {
            "description": "Conflicto de revisión o de nombre único.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RevisionConflictResponseDto"
                    },
                    {
                      "$ref": "#/components/schemas/HttpConflictResponseDto"
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Actualiza por compare-and-swap e incrementa la revisión una vez",
        "tags": [
          "uml-documents"
        ]
      },
      "delete": {
        "operationId": "DocumentsController_delete",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "documentId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "Documento inexistente o perteneciente a otro proyecto."
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Elimina un documento como OWNER o EDITOR; revisiones caen en cascada",
        "tags": [
          "uml-documents"
        ]
      }
    }
  },
  "info": {
    "title": "UML Class Designer API",
    "description": "API interna de la herramienta CASE; no es el backend Spring Boot generado.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "uml_refresh"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "maxLength": 254
          },
          "displayName": {
            "type": "string",
            "example": "Ana Pérez",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "displayName",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT de acceso breve; el cliente debe conservarlo solo en memoria."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "description": "Duración del access token en segundos.",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ProjectResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "EDITOR"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "role",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "example": "Sistema de ventas"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          }
        }
      },
      "ProjectMemberResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "EDITOR"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "AddProjectMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "ID compartido por el usuario desde su perfil."
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "editor@example.com"
          }
        },
        "required": [
          "userId",
          "email"
        ]
      },
      "RevisionConflictResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Document revision conflict."
          },
          "currentRevision": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "message",
          "currentRevision"
        ]
      },
      "HttpConflictResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 409
          },
          "message": {
            "type": "string",
            "example": "A document with that name already exists in this project."
          },
          "error": {
            "type": "string",
            "example": "Conflict"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "DocumentSummaryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string",
            "example": "0.1.0"
          },
          "revision": {
            "type": "number",
            "minimum": 0
          },
          "createdById": {
            "type": "string",
