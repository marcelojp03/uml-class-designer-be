              }
            }
          },
          "401": {
            "description": "Credenciales inválidas."
          }
        },
        "summary": "Inicia una sesión con correo y contraseña",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [
          {
            "name": "x-auth-intent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
