{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uml-class-designer.local/contracts/relational-model/0.1.0",
  "title": "UML Class Designer relational model",
  "description": "Validated intermediate relational model for PostgreSQL and the future JPA generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSchemaVersion",
    "project",
    "conventions",
    "tables",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "sourceSchemaVersion": { "const": "0.1.0" },
    "project": { "$ref": "#/$defs/project" },
    "conventions": { "$ref": "#/$defs/conventions" },
    "tables": { "type": "array", "items": { "$ref": "#/$defs/table" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,159}$" },
    "multiplicity": {
      "type": "string",
      "pattern": "^(?:\\*|[0-9]+|[0-9]+\\.\\.(?:[0-9]+|\\*))$"
    },
    "physicalName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "nonBlank": { "type": "string", "minLength": 1, "maxLength": 240 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "sourcePaths", "rule"],
      "properties": {
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "rule": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naming", "identifierMaxLength", "inheritanceStrategy", "identifierStrategy"],
      "properties": {
        "naming": { "const": "snake_case" },
        "identifierMaxLength": { "const": 63 },
        "inheritanceStrategy": { "const": "JOINED" },
        "identifierStrategy": { "const": "attribute-id-or-synthetic-uuid" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["ERROR", "WARNING", "INFO"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logicalName",
        "physicalName",
        "javaPropertyName",
        "javaType",
        "postgresType",
        "umlType",
        "nullable",
        "primaryKey",
        "source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "logicalName": { "$ref": "#/$defs/nonBlank" },
        "physicalName": { "$ref": "#/$defs/physicalName" },
        "javaPropertyName": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,159}$" },
        "javaType": { "$ref": "#/$defs/nonBlank" },
        "postgresType": { "$ref": "#/$defs/nonBlank" },
        "umlType": { "$ref": "#/$defs/nonBlank" },
        "nullable": { "type": "boolean" },
        "primaryKey": { "type": "boolean" },
        "generated": { "enum": ["UUID"] },
        "defaultValue": { "type": "string", "maxLength": 500 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "primaryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "physicalName", "columnIds", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "physicalName": { "$ref": "#/$defs/physicalName" },
        "columnIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "uniqueConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "physicalName", "columnIds", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "physicalName": { "$ref": "#/$defs/physicalName" },
        "columnIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "physicalName",
        "columnIds",
        "referencedTableId",
        "referencedColumnIds",
        "onDelete",
        "source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "physicalName": { "$ref": "#/$defs/physicalName" },
        "columnIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "referencedTableId": { "$ref": "#/$defs/id" },
        "referencedColumnIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "sourceMultiplicity": { "$ref": "#/$defs/multiplicity" },
        "targetMultiplicity": { "$ref": "#/$defs/multiplicity" },
        "onDelete": { "enum": ["NO_ACTION", "CASCADE", "SET_NULL"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "role", "source"],
      "properties": {
        "strategy": { "const": "JOINED" },
        "role": { "enum": ["root", "subclass"] },
        "parentTableId": { "$ref": "#/$defs/id" },
        "parentColumnIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logicalName",
        "physicalName",
        "javaEntityName",
        "kind",
        "columns",
        "primaryKey",
        "foreignKeys",
        "uniqueConstraints",
        "source"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "logicalName": { "$ref": "#/$defs/nonBlank" },
        "physicalName": { "$ref": "#/$defs/physicalName" },
        "javaEntityName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_$]{0,159}$" },
        "kind": { "enum": ["entity", "join", "association-class", "collection"] },
        "isAbstract": { "type": "boolean" },
        "sourceClassifierId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceRelationshipId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "primaryKey": { "$ref": "#/$defs/primaryKey" },
        "foreignKeys": { "type": "array", "items": { "$ref": "#/$defs/foreignKey" } },
        "uniqueConstraints": { "type": "array", "items": { "$ref": "#/$defs/uniqueConstraint" } },
        "inheritance": { "$ref": "#/$defs/inheritance" },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
