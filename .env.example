NODE_ENV=development
PORT=3000
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://uml_designer:local_only_change_me@localhost:5432/uml_designer?schema=public
AUTH_JWT_SECRET=development-only-jwt-secret-change-before-production-0123456789
AUTH_JWT_ISSUER=uml-class-designer-be
AUTH_JWT_AUDIENCE=uml-class-designer
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_REFRESH_COOKIE_NAME=uml_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict
COLLABORATION_SOCKET_MAX_PAYLOAD_BYTES=65536
COLLABORATION_PING_TIMEOUT_MS=20000
COLLABORATION_PING_INTERVAL_MS=25000
COLLABORATION_COMMAND_LIMIT=30
COLLABORATION_COMMAND_WINDOW_MS=10000
COLLABORATION_PRESENCE_MIN_INTERVAL_MS=100
COLLABORATION_LOCK_TTL_SECONDS=30
COLLABORATION_MAX_PARTICIPANTS_PER_DOCUMENT=100
COLLABORATION_MAX_DOCUMENTS_PER_SOCKET=20
