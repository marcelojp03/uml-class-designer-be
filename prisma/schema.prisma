generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  EDITOR
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  displayName       String
  passwordHash      String
  sessions          AuthSession[]
  ownedProjects     Project[]          @relation("ProjectOwner")
  memberships       ProjectMember[]
  createdDocuments  UmlDocument[]      @relation("DocumentCreator")
  updatedDocuments  UmlDocument[]      @relation("DocumentUpdater")
  authoredRevisions DocumentRevision[] @relation("RevisionAuthor")
  authoredOperations DocumentOperation[] @relation("OperationActor")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model AuthSession {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String                 @unique
  refreshSequence Int                   @default(0)
  consumedTokens ConsumedRefreshToken[]
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model ConsumedRefreshToken {
  tokenHash  String      @id
  sessionId  String      @db.Uuid
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  consumedAt DateTime    @default(now())

  @@index([sessionId])
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String          @db.Uuid
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  documents   UmlDocument[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model UmlDocument {
  id             String             @id @default(uuid()) @db.Uuid
  projectId      String             @db.Uuid
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  canonicalModel Json
  schemaVersion  String
  revision       Int                @default(0)
  createdById    String             @db.Uuid
  createdBy      User               @relation("DocumentCreator", fields: [createdById], references: [id])
  updatedById    String             @db.Uuid
  updatedBy      User               @relation("DocumentUpdater", fields: [updatedById], references: [id])
  revisions      DocumentRevision[]
  operations     DocumentOperation[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([createdById])
  @@index([updatedById])
}

model DocumentRevision {
  id             String      @id @default(uuid()) @db.Uuid
  documentId     String      @db.Uuid
  document       UmlDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       Int
  canonicalModel Json
  schemaVersion  String
  authorId       String      @db.Uuid
  author         User        @relation("RevisionAuthor", fields: [authorId], references: [id])
  createdAt      DateTime    @default(now())

  @@unique([documentId, revision])
  @@index([authorId])
}

model DocumentOperation {
  id                 String      @id @default(uuid()) @db.Uuid
  operationId        String      @db.Uuid
  documentId         String      @db.Uuid
  document           UmlDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId            String      @db.Uuid
  actor              User        @relation("OperationActor", fields: [actorId], references: [id], onDelete: Restrict)
  baseRevision       Int
  resultingRevision  Int
  command            Json
  commandFingerprint String      @db.Char(64)
  committedAt        DateTime    @default(now())
  broadcastedAt      DateTime?

  @@unique([documentId, operationId])
  @@index([documentId, resultingRevision])
  @@index([documentId, baseRevision])
  @@index([documentId, broadcastedAt])
  @@index([actorId])
}
