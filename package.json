{
  "name": "uml-class-designer-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend interno de la herramienta CASE UML Class Designer",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,json}\" \"!contracts/openapi.json\"",
    "format": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,json}\" \"!contracts/openapi.json\"",
    "test": "jest --runInBand",
    "test:e2e": "pnpm db:test:migrate && node --env-file=.env.test.example node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "contracts:test": "jest contracts --runInBand",
    "contracts:check": "pnpm contracts:test",
    "spring-boot:verify": "node -r ts-node/register scripts/verify-spring-boot-generation.ts",
    "spring-boot:runtime": "node -r ts-node/register scripts/spring-boot-runtime.ts",
    "spring-boot:runtime:failures": "node -r ts-node/register scripts/verify-spring-boot-runtime-failures.ts",
    "package:6a3": "node -r ts-node/register scripts/package-6a3.ts",
    "package:6a3a": "node -r ts-node/register scripts/package-6a3.ts 6A3A --verify-determinism",
    "openapi:generate": "node --env-file=.env.example -r ts-node/register scripts/generate-openapi.ts",
    "openapi:check": "node --env-file=.env.example -r ts-node/register scripts/generate-openapi.ts --check",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node --env-file=.env.example node_modules/prisma/build/index.js validate",
    "prisma:check": "pnpm prisma:validate",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down --volumes",
    "db:test:migrate": "node --env-file=.env.test.example node_modules/prisma/build/index.js migrate deploy",
    "db:test:status": "node --env-file=.env.test.example node_modules/prisma/build/index.js migrate status",
    "smoke:production": "node --env-file=.env.test.example -r ts-node/register scripts/production-smoke.ts",
    "production:smoke": "pnpm smoke:production",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm spring-boot:verify && pnpm prisma:validate && pnpm openapi:check && pnpm build"
  },
  "dependencies": {
    "@nestjs/common": "11.1.16",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.16",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.16",
    "@nestjs/platform-socket.io": "11.1.16",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.16",
    "@prisma/client": "6.19.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "archiver": "7.0.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "joi": "18.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.16",
    "@types/archiver": "7.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "newman": "6.2.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.70.0",
    "prisma": "6.19.1",
    "socket.io-client": "4.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.2"
}
